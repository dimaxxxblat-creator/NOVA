<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,14"><StackPanel><TextBlock Text="ЛОКАЛЬНЫЕ ФАЙЛЫ  /  CUR И ANI" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Соберите набор" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,6"/><TextBlock Text="Выберите роль и файл для неё. Незаданные указатели останутся прежними." Style="{StaticResource Hint}"/><Border Height="1" Background="#3A393F" Margin="0,20,0,16"/>
