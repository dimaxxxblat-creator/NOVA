<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="23" Margin="0,0,0,14"><StackPanel><TextBlock Text="ВНЕШНИЙ ВИД  /  ЭКСПЕРИМЕНТАЛЬНО" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Цвет и прозрачность" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Только основная панель задач. Настройка действует до выхода из NOVA или изменения темы Windows." Style="{StaticResource Hint}"/><Border Height="1" Background="#3A393F" Margin="0,18,0,16"/><TextBlock Text="ЦВЕТ" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Border x:Name="TaskbarColorPreview" Background="#FF7311" Width="40" Height="40" CornerRadius="9" Margin="0,0,10,0"/><TextBox x:Name="TaskbarColor" Text="#FF7311" Width="125" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Content="Выбрать цвет" Click="TaskbarColor_Click" Margin="10,0,0,0"/></StackPanel><TextBlock Text="НЕПРОЗРАЧНОСТЬ" Style="{StaticResource Eyebrow}" Margin="0,22,0,8"/><StackPanel Orientation="Horizontal"><Slider x:Name="TaskbarOpacity" Width="260" Minimum="0" Maximum="100" Value="55" TickFrequency="5" IsSnapToTickEnabled="True" Foreground="{DynamicResource NovaAccent}" VerticalAlignment="Center"/><TextBlock Text="{Binding Value, ElementName=TaskbarOpacity, StringFormat={}{0:0}%}" Foreground="#D6D4DA" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="0% — прозрачный оттенок; 100% — непрозрачный. Видимость зависит от Windows и её темы." Style="{StaticResource Hint}" Margin="0,8,0,0"/><WrapPanel Margin="0,22,0,0"><Button Content="Применить" Style="{StaticResource Primary}" Click="TaskbarApply_Click"/><Button Content="Завершить управление" Style="{StaticResource Quiet}" Click="TaskbarRestore_Click"/></WrapPanel><TextBlock x:Name="TaskbarStatus" Text="NOVA пока не изменяла панель задач." Style="{StaticResource Hint}" Margin="0,14,0,0"/></StackPanel></Border>
<Border Background="#1B1B1F" BorderBrush="#3A393F" BorderThickness="1" CornerRadius="16" Padding="23" Margin="0,0,0,14"><StackPanel><TextBlock Text="СИСТЕМНЫЕ НАСТРОЙКИ" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Если эффект не отображается" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="На Windows 11 панель может рисоваться поверх эффекта, даже когда Windows принимает команду. NOVA не внедряется в Проводник и не может гарантировать видимый результат. Для цвета и системной прозрачности используйте настройки Windows." Style="{StaticResource Hint}"/><Button Content="Открыть цвета Windows" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenWindowsColors_Click"/></StackPanel></Border>
</StackPanel>
<!-- SEASONAL EFFECTS -->
<StackPanel x:Name="DesktopSnowPage" Visibility="Collapsed"><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО  /  ЭФФЕКТЫ" Style="{StaticResource Eyebrow}" Margin="0,0,0,18"/><TextBlock Text="Сезонные эффекты" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Снег, листья, дождь или лепестки поверх рабочего стола." Style="{StaticResource Hint}" FontSize="15" Margin="0,7,0,28"/>
<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,14"><StackPanel><TextBlock Text="АТМОСФЕРА  /  РАБОЧИЙ СТОЛ" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Выберите эффект" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,6"/><TextBlock Text="Частицы не должны перехватывать клики. Эффекты скрываются при блокировке и некоторых полноэкранных приложениях." Style="{StaticResource Hint}"/><Border Height="1" Background="#3A393F" Margin="0,20,0,16"/>
<TextBlock Text="СЕЗОН" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ComboBox x:Name="SeasonBox" Width="220" HorizontalAlignment="Left" SelectionChanged="Season_Changed"><ComboBoxItem Content="Снег" IsSelected="True"/><ComboBoxItem Content="Осенние листья"/><ComboBoxItem Content="Дождь"/><ComboBoxItem Content="Цветочные лепестки"/></ComboBox>
<Border Background="#15171B" BorderBrush="#3D3A3D" BorderThickness="1" CornerRadius="12" Height="180" Margin="0,18,0,0" ClipToBounds="True"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#14191F" Offset="0"/><GradientStop Color="#3A2821" Offset="1"/></LinearGradientBrush></Grid.Background><Path Data="M 0,120 L 95,80 175,115 250,66 370,126 470,74 650,128" Stroke="#5D5554" StrokeThickness="1" Stretch="Fill" Opacity="0.5"/><views:SnowOverlay x:Name="SeasonPreview" IsHitTestVisible="False"/><Border Background="#B4141418" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4"><TextBlock Text="ПРЕДПРОСМОТР" FontSize="10" FontWeight="SemiBold" Foreground="#F5C19D"/></Border></Grid></Border><TextBlock Text="Предпросмотр не включает эффект на рабочем столе." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
<TextBlock Text="ИНТЕНСИВНОСТЬ" Style="{StaticResource Eyebrow}" Margin="0,20,0,8"/><StackPanel Orientation="Horizontal"><Slider x:Name="SeasonIntensity" Width="260" Minimum="25" Maximum="200" TickFrequency="25" IsSnapToTickEnabled="True" Value="100" ValueChanged="WeatherSlider_Changed"/><TextBlock Text="{Binding Value, ElementName=SeasonIntensity, StringFormat={}{0:0}%}" Foreground="#D6D4DA" Margin="14,0,0,0"/></StackPanel>
<TextBlock Text="СКОРОСТЬ" Style="{StaticResource Eyebrow}" Margin="0,20,0,8"/><StackPanel Orientation="Horizontal"><Slider x:Name="SeasonSpeed" Width="260" Minimum="25" Maximum="200" TickFrequency="25" IsSnapToTickEnabled="True" Value="100" ValueChanged="WeatherSlider_Changed"/><TextBlock Text="{Binding Value, ElementName=SeasonSpeed, StringFormat={}{0:0}%}" Foreground="#D6D4DA" Margin="14,0,0,0"/></StackPanel><TextBlock Text="Количество частиц ограничено для снижения нагрузки. Изменения сохраняются автоматически." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
<Border Height="1" Background="#3A393F" Margin="0,20,0,12"/><CheckBox x:Name="ShowDesktopCaps" Content="Сугробы на окнах — только для снега" Checked="DesktopCaps_Changed" Unchecked="DesktopCaps_Changed"/><TextBlock Text="Перетаскивайте сугробы мышью у верхнего края обычных окон. Видно до 10 сугробов; перекрытые и полноэкранные окна пропускаются. Положение хранится, пока окно открыто." Style="{StaticResource Hint}" Margin="30,0,0,0"/><WrapPanel Margin="0,22,0,0"><Button x:Name="DesktopSnowButton" Content="Включить эффект" Style="{StaticResource Primary}" Click="ToggleDesktopSnow_Click"/></WrapPanel><TextBlock x:Name="DesktopSnowStatus" Text="Эффект выключен." Style="{StaticResource Hint}" Margin="0,13,0,0"/></StackPanel></Border>
<Border Background="#1B1B1F" BorderBrush="#3A393F" BorderThickness="1" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="КАК ЭТО РАБОТАЕТ" Style="{StaticResource Eyebrow}"/><TextBlock Text="Эффект — отдельный слой NOVA, он не меняет ваши файлы и обои. Сугроб перехватывает мышь в пределах своей формы; если он мешает кнопкам окна, переместите или отключите его. При полном выходе из NOVA эффект исчезает." Style="{StaticResource Hint}" Margin="0,9,0,0"/></StackPanel></Border></StackPanel>
<!-- CURSOR SET -->
