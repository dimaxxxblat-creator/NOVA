<StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="ПРИЛОЖЕНИЕ  /  НАСТРОЙКИ" Style="{StaticResource Eyebrow}" Margin="0,0,0,18"/><TextBlock Text="Настройки" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Настройте NOVA под себя." Style="{StaticResource Hint}" FontSize="15" Margin="0,7,0,28"/>
<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="23" Margin="0,0,0,14"><StackPanel><TextBlock Text="01  /  ОСНОВНЫЕ" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Приложение" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Управление запуском и работой в фоне." Style="{StaticResource Hint}"/><Border Height="1" Background="#3A393F" Margin="0,18,0,8"/><CheckBox x:Name="AutoStart" Content="Запускать NOVA вместе с Windows"/><TextBlock Text="Закрытие окна сворачивает NOVA в трей. Для полного выхода используйте меню значка в трее." Style="{StaticResource Hint}" Margin="30,0,0,12"/><CheckBox x:Name="ShowSnow" Content="Снег и сугробы в интерфейсе NOVA" Checked="Snow_Changed" Unchecked="Snow_Changed"/><CheckBox x:Name="ShowGarland" Content="Мерцающая гирлянда в окне NOVA" Checked="Garland_Changed" Unchecked="Garland_Changed"/><CheckBox x:Name="AccessibleModeBox" Content="Режим доступности: крупнее, контрастнее, без декоративной анимации" Checked="AccessibleMode_Changed" Unchecked="AccessibleMode_Changed"/><TextBlock Text="Увеличивает элементы, повышает контраст подсказок и временно отключает снег, гирлянду и сезонные эффекты NOVA. Воспроизведение обоев не останавливается." Style="{StaticResource Hint}" Margin="30,0,0,8"/><CheckBox x:Name="ShowAnimations" Content="Плавные переходы и подсветка при наведении" Checked="Animations_Changed" Unchecked="Animations_Changed"/><TextBlock Text="ЦВЕТОВОЙ АКЦЕНТ" Style="{StaticResource Eyebrow}" Margin="0,18,0,8"/><ComboBox x:Name="ThemeBox" Width="230" HorizontalAlignment="Left" SelectionChanged="Theme_Changed"><ComboBoxItem Content="Оранжевый"/><ComboBoxItem Content="Голубой"/><ComboBoxItem Content="Фиолетовый"/><ComboBoxItem Content="Мятный"/></ComboBox><TextBlock Text="НАСЫЩЕННОСТЬ АКЦЕНТА" Style="{StaticResource Eyebrow}" Margin="0,17,0,8"/><StackPanel Orientation="Horizontal"><Slider x:Name="AccentStrengthSlider" Width="230" Minimum="50" Maximum="100" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="AccentStrength_Changed"/><TextBlock Text="{Binding Value, ElementName=AccentStrengthSlider, StringFormat={}{0:0}%}" Foreground="#D6D4DA" Margin="14,0,0,0"/></StackPanel><TextBlock Text="Тёмный фон остаётся прежним. Цвет и насыщенность меняются сразу." Style="{StaticResource Hint}" Margin="0,9,0,0"/><CheckBox x:Name="AutoThumbnailBox" Content="Создавать миниатюры видео без обложек автоматически" Checked="AutoThumbnail_Changed" Unchecked="AutoThumbnail_Changed"/><TextBlock Text="Windows может использовать установленные сторонние обработчики и кодеки. Только локальные файлы; исходные файлы не меняются." Style="{StaticResource Hint}" Margin="30,0,0,0"/><TextBlock Text="Снег и гирлянда работают только в окне программы: нажмите «Сохранить настройки» для их сохранения. Акцент, анимации и миниатюры сохраняются сразу." Style="{StaticResource Hint}" Margin="30,0,0,0"/></StackPanel></Border>
<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="23" Margin="0,0,0,14"><StackPanel><TextBlock Text="02  /  ВОСПРОИЗВЕДЕНИЕ" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Производительность" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Решите, когда обои должны приостанавливаться." Style="{StaticResource Hint}"/><Border Height="1" Background="#3A393F" Margin="0,18,0,8"/><CheckBox x:Name="PauseFullscreen" Content="Пауза при полноэкранном приложении на выбранном мониторе"/><CheckBox x:Name="PauseLocked" Content="Пауза при блокировке компьютера"/><TextBlock Text="ГРОМКОСТЬ ВИДЕО" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/><Slider x:Name="Volume" Foreground="{DynamicResource NovaAccent}" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" MaxWidth="380" HorizontalAlignment="Left" Width="350"/><TextBlock Text="Для веб-обоев: 0 — без звука, больше 0 — звук включён. Веб-пауза частичная: независимый JavaScript может продолжать работу." Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="23" Margin="0,0,0,14"><StackPanel><TextBlock Text="03  /  БЕЗОПАСНОСТЬ" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Веб-обои" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Сетевой доступ для локальных проектов." Style="{StaticResource Hint}"/><Border Height="1" Background="#3A393F" Margin="0,18,0,8"/><CheckBox x:Name="AllowNetwork" Content="Разрешить веб-обоям доступ к интернету"/><TextBlock Text="Изменение применяется после повторного запуска обоев. Веб-проекты содержат JavaScript — используйте только доверенные источники. Ограничение сети не является защитной песочницей." Style="{StaticResource Hint}" Margin="30,0,0,0"/></StackPanel></Border>
<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="23" Margin="0,0,0,14"><StackPanel><TextBlock Text="04  /  ИНТЕГРАЦИЯ" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Wallpaper Engine" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Для сцен требуется отдельно установленная и запущенная программа." Style="{StaticResource Hint}"/><Border Height="1" Background="#3A393F" Margin="0,18,0,16"/><TextBlock Text="ПУТЬ К ПРОГРАММЕ" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><DockPanel><Button Content="Выбрать EXE" DockPanel.Dock="Right" Click="ChooseWE_Click" Margin="10,0,0,0"/><TextBox x:Name="WEPath" IsReadOnly="True"/></DockPanel><TextBlock Text="Индекс монитора Wallpaper Engine (с 0; порядок может отличаться от Windows)" Style="{StaticResource Hint}" Margin="0,16,0,8"/><TextBox x:Name="WEIndex" Text="0" Width="100" HorizontalAlignment="Left"/><TextBlock Text="Команда открытия заменит обои на указанном мониторе Wallpaper Engine." Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
<Border Background="#222227" BorderBrush="#34343A" BorderThickness="1" CornerRadius="16" Padding="23" Margin="0,0,0,20"><StackPanel><TextBlock Text="05  /  ДАННЫЕ" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NovaAccentLight}"/><TextBlock Text="Данные и совместимость" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock x:Name="DataPath" Style="{StaticResource Hint}" Margin="0,5,0,0"/><Border Height="1" Background="#3A393F" Margin="0,18,0,16"/><TextBlock Text="Видео / GIF — VLC; веб — WebView2 (частичная совместимость); сцены — внешний Wallpaper Engine; Application — не запускаются." Style="{StaticResource Hint}"/><Button Content="Открыть папку данных" HorizontalAlignment="Left" Margin="0,15,0,0" Click="OpenData_Click" Style="{StaticResource Quiet}"/></StackPanel></Border>
<Button Content="Сохранить настройки" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
