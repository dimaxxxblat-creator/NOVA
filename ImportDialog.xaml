<Window x:Class="Nova.App.Views.ImportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Добавить обои" WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="520" MinWidth="520" ResizeMode="NoResize" ShowInTaskbar="False" Background="#161619" Foreground="#F8F8F9" FontFamily="Segoe UI">
<StackPanel Margin="28,26,28,28">
<TextBlock Text="БИБЛИОТЕКА  /  ИМПОРТ" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/><TextBlock Text="Добавить обои" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Выберите, что хотите добавить в библиотеку." Style="{StaticResource Hint}" Margin="0,7,0,22"/>
<Button Click="File_Click" Background="#242429" BorderBrush="#3B3A40" Margin="0,0,0,10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#35271F" CornerRadius="11" Margin="0,0,14,0"><Path Data="M 3,1 L 12,1 17,6 17,20 3,20 Z M 12,1 L 12,6 17,6" Stroke="#FF9A54" StrokeThickness="1.3" Width="18" Height="20" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Выбрать файл" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="MP4, WebM, GIF, HTML или project.json" Foreground="#A6A5AB" FontSize="12" FontWeight="Normal" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" Foreground="#A6A5AB" FontSize="19" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></Button>
<Button Click="Folder_Click" Background="#242429" BorderBrush="#3B3A40" Margin="0,0,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#35271F" CornerRadius="11" Margin="0,0,14,0"><Path Data="M 1,4 L 7,4 9,6 19,6 19,17 1,17 Z" Stroke="#FF9A54" StrokeThickness="1.3" Width="21" Height="17" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Выбрать папку" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Веб-обои или проекты Wallpaper Engine" Foreground="#A6A5AB" FontSize="12" FontWeight="Normal" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" Foreground="#A6A5AB" FontSize="19" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></Button>
<TextBlock Text="Исходные файлы останутся на своём месте." Style="{StaticResource Hint}" FontSize="12" Margin="0,18,0,0"/>
</StackPanel></Window>
