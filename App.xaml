<Application x:Class="Nova.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nova.App.Views" StartupUri="MainWindow.xaml" ShutdownMode="OnExplicitShutdown">
<Application.Resources>
<views:PreviewConverter x:Key="PreviewConverter"/>
<SolidColorBrush x:Key="Bg" Color="#0E0E10"/><SolidColorBrush x:Key="Panel" Color="#222227"/><SolidColorBrush x:Key="Accent" Color="#FF7311"/><SolidColorBrush x:Key="Muted" Color="#A6A5AB"/><SolidColorBrush x:Key="Line" Color="#343339"/>
<SolidColorBrush x:Key="NovaHint" Color="#A6A5AB"/><SolidColorBrush x:Key="NovaEyebrow" Color="#8F8D95"/>
<SolidColorBrush x:Key="NovaAccent" Color="#FF7311"/><SolidColorBrush x:Key="NovaAccentLight" Color="#FFAD76"/><SolidColorBrush x:Key="NovaAccentSurface" Color="#3A2A20"/><SolidColorBrush x:Key="NovaAccentBorder" Color="#8B5A39"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F8F8F9"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource NovaEyebrow}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
